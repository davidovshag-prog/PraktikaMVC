@model WebStoreMVC.Models.Product.ProductItemModel

@{
    ViewData["Title"] = Model.Name;
    var mainImage = Model.Images.FirstOrDefault() ?? "no-image.webp";
}

<div class="container py-2">
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item">
                <a asp-controller="Home" asp-action="Index">Головна</a>
            </li>

            <li class="breadcrumb-item">
                <a asp-controller="Home"
                   asp-action="Products"
                   asp-route-categorySlug="@Model.CategorySlug">
                    @Model.CategoryName
                </a>
            </li>

            <li class="breadcrumb-item active">
                @Model.Name
            </li>
        </ol>
    </nav>

    <div class="row g-5">

        <!-- Фото товару -->
        <div class="col-md-6">
            <div class="card shadow border-0">
                <img src="@($"/images/800_{mainImage}")"
                     class="img-fluid rounded"
                     alt="@Model.Name">
            </div>

            @if (Model.Images.Count > 1)
            {
                <div class="row mt-3">
                    @foreach (var image in Model.Images)
                    {
                        <div class="col-3">
                            <img src="@($"/images/200_{image}")"
                                 class="img-thumbnail"
                                 alt="@Model.Name">
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Інформація -->
        <div class="col-md-6">

            <span class="badge bg-secondary mb-3">
                @Model.CategoryName
            </span>

            <h1 class="fw-bold mb-3">
                @Model.Name
            </h1>

            <h2 class="text-primary fw-bold mb-4">
                @Model.Price.ToString("0.00") грн
            </h2>

            <div class="mb-4">
                <p class="lead">
                    @Model.Description
                </p>
            </div>

            <form asp-controller="Cart"
                  asp-action="AddToCart"
                  method="post">

                <input type="hidden"
                       name="productId"
                       value="@Model.Id" />

                <div class="row align-items-center g-3">

                    <div class="col-auto">
                        <label class="form-label">Кількість</label>
                        <input type="number"
                               name="quantity"
                               value="1"
                               min="1"
                               class="form-control"
                               style="width:100px;">
                    </div>

                    <div class="col">
                        <button type="submit"
                                class="btn btn-success btn-lg w-100">
                            🛒 Додати в кошик
                        </button>
                    </div>

                </div>
            </form>

        </div>

    </div>

</div>